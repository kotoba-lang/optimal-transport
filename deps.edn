;; kotoba-lang/optimal-transport -- entropic-OT (Sinkhorn) mesh shape
;; interpolation for morph targets (ADR-2607199991, com-junkawasaki/root).
;; Intentionally dependency-free: Sinkhorn only needs scalar exp/log/+/-/*
;; and row/col sums over [x y z] triples, so this repo vendors its own tiny
;; vec3 helpers (same convention as character/skeleton/vrm) rather than add
;; a shared-math dependency.
{:paths ["src" "test"]
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
                  :main-opts ["-m" "cognitect.test-runner"]}
           ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
           :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
                  :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                              "--fail-level" "error"]}}}
